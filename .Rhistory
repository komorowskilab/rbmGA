library(org.Hs.eg.db)
library(R.ROSETTA)
library(MVN)
library(ggplot2)
library(stringr)
library(pheatmap)
library(csVisuNet)
library(import)
path <- c("../data/data_all_old/") # Contains read counts for each sample individually for .e.g. SJACT001_D.RNA-Seq.feature-counts.txt
df=data.frame()
# in one pipeline:
re<- function(df,path){
if (empty(df)){
df <- path %>% list.files(pattern = "(?i)\\.txt|.txt%0D$", full.names = TRUE) %>%
set_names(tools::file_path_sans_ext(basename(.))) %>%
map_dfr(read.delim, col.names = c('V1', "V2"), .id = "colname") %>%
pivot_wider(names_from = colname, values_from = V2)
return(as.data.frame(df))
}
else{
df_new <- path %>% list.files(pattern = "(?i)\\.txt|.txt%0D$", full.names = TRUE) %>%
set_names(tools::file_path_sans_ext(basename(.))) %>%
map_dfr(read.delim, col.names = c('V1', "V2"), .id = "colname") %>%
pivot_wider(names_from = colname, values_from = V2)
return(merge(df,as.data.frame(df_new),by='V1'))
}
}
for(value in path){
df<-re(df,value)
}
df<- df %>% column_to_rownames(.,'V1')
df <- as.data.frame(t(df))
library(org.Hs.eg.db)
ourCols <- c("SYMBOL",'GENETYPE')
annot <- AnnotationDbi::select(org.Hs.eg.db,
keys=colnames(df),
columns=ourCols,
keytype="SYMBOL")
