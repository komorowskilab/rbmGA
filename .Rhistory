df=data.frame()
# in one pipeline:
re<- function(df,path){
if (empty(df)){
df <- path %>% list.files(pattern = "(?i)\\.txt|.txt%0D$", full.names = TRUE) %>%
set_names(tools::file_path_sans_ext(basename(.))) %>%
map_dfr(read.delim, col.names = c('V1', "V2"), .id = "colname") %>%
pivot_wider(names_from = colname, values_from = V2)
return(as.data.frame(df))
}
else{
df_new <- path %>% list.files(pattern = "(?i)\\.txt|.txt%0D$", full.names = TRUE) %>%
set_names(tools::file_path_sans_ext(basename(.))) %>%
map_dfr(read.delim, col.names = c('V1', "V2"), .id = "colname") %>%
pivot_wider(names_from = colname, values_from = V2)
return(merge(df,as.data.frame(df_new),by='V1'))
}
}
