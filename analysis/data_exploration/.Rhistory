age <- c(29, 29, 28, 25, 26, 28, 24, 21, 29, 22, 27, 20, 30, 24, 27,
25, 23, 20, 23, 21, 26, 28, 24, 29, 21, 24, 30, 24, 25, 29, 26,
22, 27, 23, 22, 30, 28, 28, 26, 24)
plot(credits,age)
plot(credits,age)
s2_x<-var(age) #variance
s_xy<-cov(age,credits) #covariance
b1_hat<- s_xy/s2_x #slope
xbar<-mean(age)
ybar<-mean(credits)
b0_hat<-ybar - b1_hat*xbar #intercept
m3<-lm(credits~age)
summary(m)
summary(m3)
