hba1c <- c(6.1, 6.3, 6.4, 6.8, 7.0, 7.1, 7.5, 7.7, 7.9, 8.7,
9.4, 10.6, 8.7, 8.9, 11.2, 13.7, 12.1)
fpg <- c(141, 158, 112, 153, 134, 95, 96, 78, 148, 172,
200, 103, 172, 359, 145, 147, 231)
plot(hba1c,fpg)
s2_x<-var(fpg)
s_xy<-cov(fpg,hba1c)
b1_hat<- s2_x/s_xy
xbar<-mean(hba1c)
ybar<-mean(fpg)
b0_hat<-ybar - b1_hat*xbar
m<-lm(hba1c~fpg)
plot(hba1c,fpg)
abline(m)
m
s2_x<-var(fpg)
s_xy<-cov(fpg,hba1c)
b1_hat<- s_xy/s2_x
xbar<-mean(hba1c)
ybar<-mean(fpg)
b0_hat<-ybar - b1_hat*xbar
m<-lm(hba1c~fpg)
xbar<-mean(fpg)
ybar<-mean(hba1c)
b0_hat<-ybar - b1_hat*xbar
m<-lm(hba1c~fpg)
plot(hba1c,fpg)
abline(m)
m$coefficients[2]
#FPG mg/ml of 250
hba1c_250<- m$coefficients[1] + m$coefficients[2]*250
hba1c_250
predict(m,250)
df_predict<-data.frame(fpg=c(250))
predict(m,df_predict)
#FPG mg/ml of 250
hba1c_250<- as.numeric(m$coefficients[1] + m$coefficients[2]*250)
hba1c_250
m$residuals
#RSS,TSS,ESS
yhat<-m$fitted.values
ei<- hba1c - yhat
RSS<- sum(ei^2)
RSS
RSS<- sum(m$residuals^2)
RSS
TSS <- sum((hba1c - mean(hba1c))^2)
1-(RSS/TSS) #coefficeint of determination
coef_det<-1-(RSS/TSS) #coefficeint of determination
#It has six percent of variation in the dependenet variable that is predictable from the independent variable t
#assuming linear relationship.
sumamry(m)
#It has six percent of variation in the dependenet variable that is predictable from the independent variable t
#assuming linear relationship.
summary(m)
source("~/Documents/PhD/Courses/Biostatistics/exercise_R_book_lm.R")
#It has six percent of variation in the dependenet variable that is predictable from the independent variable t
#assuming linear relationship.
summary(m)
coef_det
log_hba1c<-log(hba1c)
m2<-lm(log_hba1c~fpg)
summary(m2)
100*(exp(m$coefficients[2])-1)
df_predict_2<-data.frame(fpg=c(200))
predict(m2,df_predict_2)
