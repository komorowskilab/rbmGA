# Number of random samples (can be decreased if time consuming)
k <- 100000
# Sample size in a sample
n <- 5
# Vector to save means()
estimate <- c(NA, k)
# Simulate
for(i in 1:k){
# Select population and estimator by changing using
x <- rchisq(n, df = 6)
# x <- rnorm(n, 4, 2)
# x <- runif(n, 0,5)
# Estimate the mean in each sample
estimate[i] <- mean(x)
# Estimate the variance in each sample
# estimate[i] <- var(x)
# Estimate the sd in each sample
# estimate[i] <- sd(x)
# Estimate the median in each sample
# estimate[i] <- median(x)
print(i)
}
# Study the true underlying distribution
# by taking a very large sample
x_pop <- rchisq(1000000, df = 6)
# x <- rnorm(1000000, 4, 2)
# x <- runif(1000000, 0,5)
hist(x, breaks = 1000)
# Calculate mu
mean(x_pop)
# Calculate population variance, sigma2
var(x_pop)
# Calculate population standard deviaton, sigma
sd(x_pop)
# Calculate population median
median(x_pop)
# Look at the sampling distribution
hist(estimate)
# Calculate E(estimate) i.e. the mean of all means.
mean(estimate)
# Calculate V(estimate) i.e. the variance of all means.
var(estimate)
# Calculate SE(estimate) i.e. the standard error of all means.
sd(estimate)
