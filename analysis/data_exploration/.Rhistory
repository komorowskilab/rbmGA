library(ggplot2)
# Example df
df <- data.frame(
Nof = 1:10,
RBM_accuracy_std = runif(10, 80, 95),
Other_accuracy = runif(10, 75, 90)
)
# Plot with legend for shapes
ggplot(df) +
geom_point(aes(x = Nof, y = Other_accuracy, shape = "Other Accuracy", color = "Other Accuracy"), size = 5) +
geom_point(aes(x = Nof, y = RBM_accuracy_std, shape = "RBM Accuracy", color = "RBM Accuracy"), size = 5) +
scale_shape_manual(values = c("Other Accuracy" = 3, "RBM Accuracy" = 4)) +
scale_color_manual(values = c("Other Accuracy" = "black", "RBM Accuracy" = "red")) +
labs(
x = "Nof",
y = "Accuracy (%)",
shape = "Legend",
color = "Legend"
) +
theme_minimal()
