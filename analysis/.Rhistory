#Run Genetic 100 times and take common part as rules.
#One consensus network
genetic_consensus<-function(ros_data,num_of_iter=100,discrete=FALSE){
x<-new.env(hash = TRUE, parent = parent.frame(), size = 29L)
decision_var<-names(ros_data)[ncol(ros_data)]
decision_roc<-names(table(eval(parse(text=paste("ros_data$", decision_var, sep = ""))))[1])
for(i in 1:num_of_iter){
#shuffle column here
start_time<- Sys.time()
print(start_time)
print(paste('Iteration Number:',i))
ros<-rosetta(ros_data,reducerDiscernibility = 'Object',roc=TRUE,discrete = discrete,reducer = 'Johnson',clroc=decision_roc,ruleFiltration = TRUE)
assign(paste0('ros_',i),ros$main )
end_time<- Sys.time()
print(paste('This iteration took in seconds',end_time-start_time))
if(i == 1){
total_time<- ((end_time-start_time)/60)*num_of_iter
cat(paste('Total time for execution of Consensus Genetic would be',total_time,'Minutes'))
}
}
rbms<- mget(ls(pattern = "ros_[0-9]"))
nrls<-mergeRBMs(rbms,defClass = eval(parse(text=paste("ros_data$", decision_var, sep = ""))))
return(nrls)
}
genetic_consensus(autcon,10)
cat(paste('Approximate time for execution of Consensus Genetic would be',total_time,'Minutes\n'))
